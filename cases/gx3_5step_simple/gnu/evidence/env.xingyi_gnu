#!/bin/csh -f

set inp = "undefined"
if ($#argv == 1) then
  set inp = $1
endif

if ("$inp" != "-nomodules") then

if ($?MODULESHOME) then
  source ${MODULESHOME}/init/csh
endif

module load mpi/mpich/4.1.2-gcc-11.4.0-ch4
module load hdf5/1.14.3-gcc-11.4.0-mpich-4.1.2-ch4
module load netcdf/4.9.2-gcc-11.4.0-mpich-4.1.2-ch4

limit coredumpsize unlimited
limit stacksize unlimited

# May be needed for OpenMP memory
setenv OMP_STACKSIZE 64M

endif

setenv ICE_MACHINE_MACHNAME xingyi
setenv ICE_MACHINE_MACHINFO "TianheXY-C Xingyi cluster, ubuntu 22.04, 64 cores per node"
setenv ICE_MACHINE_ENVNAME gnu
setenv ICE_MACHINE_ENVINFO "gcc 11.4.0, mpich 4.1.2"
setenv ICE_MACHINE_MAKE make
setenv ICE_MACHINE_WKDIR $HOME/HDD_POOL/zxy/cice-dirs/runs
setenv ICE_MACHINE_INPUTDATA $HOME/HDD_POOL/zxy/CICE/input
setenv ICE_MACHINE_BASELINE $HOME/HDD_POOL/zxy/cice-dirs/baseline
setenv ICE_MACHINE_SUBMIT "yhbatch"
setenv ICE_MACHINE_ACCT P0000000
setenv ICE_MACHINE_QUEUE "debug"
setenv ICE_MACHINE_TPNODE 64
setenv ICE_MACHINE_BLDTHRDS 4
setenv ICE_MACHINE_QSTAT "yhq --jobs= "
